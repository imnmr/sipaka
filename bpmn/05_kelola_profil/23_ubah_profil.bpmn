<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ubah Profil (Kelola Profil)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Data_profil_baru" name="Data profil baru" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konfirmasi_profil_diperbarui" name="Konfirmasi profil diperbarui" />
  <bpmn:message id="Message_Pesan_kesalahan_profil" name="Pesan kesalahan profil" />
  <bpmn:message id="Message_Data_profil_diperbaiki" name="Data profil diperbaiki" />
  <bpmn:dataStore id="d_profil-store" name="Profil Pengguna" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Ubah Profil" processRef="ubah_profil" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Data profil baru" sourceRef="user" targetRef="mulai" messageRef="Message_Data_profil_baru" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi profil diperbarui" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_profil_diperbarui" />
    <bpmn:messageFlow id="m-pesan-user" name="Pesan kesalahan profil" sourceRef="pesan" targetRef="user" messageRef="Message_Pesan_kesalahan_profil" />
    <bpmn:messageFlow id="m-user-perbaiki" name="Data profil diperbaiki" sourceRef="user" targetRef="perbaiki" messageRef="Message_Data_profil_diperbaiki" />
  </bpmn:collaboration>
  <bpmn:process id="ubah_profil" name="Ubah Profil (Kelola Profil)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Perubahan profil diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Data_profil_baru" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="valid" name="Validasi data profil" />
    <bpmn:exclusiveGateway id="ok" name="Data profil valid?" default="f-ok-pesan" />
    <bpmn:serviceTask id="simpan" name="Simpan perubahan profil">
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:targetRef>d_profil</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="pesan" name="Kirim pesan kesalahan data profil" messageRef="Message_Pesan_kesalahan_profil" />
    <bpmn:receiveTask id="perbaiki" name="Terima data profil yang diperbaiki" messageRef="Message_Data_profil_diperbaiki" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:endEvent id="selesai" name="Profil diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_profil_diperbarui" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-valid" name="ya" sourceRef="izin" targetRef="valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-perbaiki-valid" sourceRef="perbaiki" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-ok" sourceRef="valid" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-simpan" name="ya" sourceRef="ok" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">profilValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-pesan" name="tidak" sourceRef="ok" targetRef="pesan" />
    <bpmn:sequenceFlow id="f-simpan-selesai" sourceRef="simpan" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-pesan-perbaiki" sourceRef="pesan" targetRef="perbaiki" />
    <bpmn:dataStoreReference id="d_profil" name="Profil Pengguna" dataStoreRef="d_profil-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1050" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="160" y="490" width="1050" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
