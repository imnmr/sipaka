<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lihat Profil (Kelola Profil)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Permintaan_buka_profil" name="Permintaan buka profil" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Poin_reputasi" name="Poin reputasi" />
  <bpmn:message id="Message_Lencana_pengguna" name="Lencana pengguna" />
  <bpmn:message id="Message_Riwayat_aktivitas" name="Riwayat aktivitas" />
  <bpmn:dataStore id="d_poin-store" name="Poin Reputasi" />
  <bpmn:dataStore id="d_lencana-store" name="Lencana" />
  <bpmn:dataStore id="d_komen-store" name="Komentar" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Lihat Profil" processRef="lihat_profil" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan buka profil" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_buka_profil" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-poin-user" name="Poin reputasi" sourceRef="poin" targetRef="user" messageRef="Message_Poin_reputasi" />
    <bpmn:messageFlow id="m-lencana-user" name="Lencana pengguna" sourceRef="lencana" targetRef="user" messageRef="Message_Lencana_pengguna" />
    <bpmn:messageFlow id="m-r5-user" name="Riwayat aktivitas" sourceRef="r5" targetRef="user" messageRef="Message_Riwayat_aktivitas" />
  </bpmn:collaboration>
  <bpmn:process id="lihat_profil" name="Lihat Profil (Kelola Profil)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan profil diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_buka_profil" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:parallelGateway id="pisah" />
    <bpmn:sendTask id="poin" name="Tampilkan Poin Reputasi" messageRef="Message_Poin_reputasi">
      <bpmn:ioSpecification id="poin-io">
        <bpmn:dataInput id="poin-in-1" name="Poin Reputasi" />
        <bpmn:inputSet id="poin-inputs">
          <bpmn:dataInputRefs>poin-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="poin-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="poin-dia-1">
        <bpmn:sourceRef>d_poin</bpmn:sourceRef>
        <bpmn:targetRef>poin-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:sendTask id="lencana" name="Tampilkan Lencana" messageRef="Message_Lencana_pengguna">
      <bpmn:ioSpecification id="lencana-io">
        <bpmn:dataInput id="lencana-in-2" name="Lencana" />
        <bpmn:inputSet id="lencana-inputs">
          <bpmn:dataInputRefs>lencana-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="lencana-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="lencana-dia-2">
        <bpmn:sourceRef>d_lencana</bpmn:sourceRef>
        <bpmn:targetRef>lencana-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="gabung" />
    <bpmn:endEvent id="selesai" name="Profil selesai ditampilkan" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:subProcess id="riwayat" name="Tampilkan Riwayat Aktivitas">
      <bpmn:startEvent id="r1" name="Mulai riwayat aktivitas" />
      <bpmn:callActivity id="r2" name="Tampilkan Daftar Diskusi" calledElement="jelajahi_diskusi">
        <bpmn:documentation>Langkah 'Tampilkan Daftar Diskusi' pada proses Jelajahi Diskusi (disaring menurut penulis)</bpmn:documentation>
      </bpmn:callActivity>
      <bpmn:serviceTask id="r3" name="Susun riwayat thread dan komentar pengguna">
        <bpmn:ioSpecification id="r3-io">
          <bpmn:dataInput id="r3-in-3" name="Thread Diskusi" />
          <bpmn:dataInput id="r3-in-4" name="Komentar" />
          <bpmn:inputSet id="r3-inputs">
            <bpmn:dataInputRefs>r3-in-3</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>r3-in-4</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="r3-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="r3-dia-3">
          <bpmn:sourceRef>d_thread</bpmn:sourceRef>
          <bpmn:targetRef>r3-in-3</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="r3-dia-4">
          <bpmn:sourceRef>d_komen</bpmn:sourceRef>
          <bpmn:targetRef>r3-in-4</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:sendTask id="r5" name="Kirim riwayat aktivitas" messageRef="Message_Riwayat_aktivitas" />
      <bpmn:endEvent id="r4" name="Riwayat tampil" />
      <bpmn:sequenceFlow id="f-r1-r2" sourceRef="r1" targetRef="r2" />
      <bpmn:sequenceFlow id="f-r2-r3" sourceRef="r2" targetRef="r3" />
      <bpmn:sequenceFlow id="f-r3-r5" sourceRef="r3" targetRef="r5" />
      <bpmn:sequenceFlow id="f-r5-r4" sourceRef="r5" targetRef="r4" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pisah" name="ya" sourceRef="izin" targetRef="pisah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pisah-poin" sourceRef="pisah" targetRef="poin" />
    <bpmn:sequenceFlow id="f-pisah-lencana" sourceRef="pisah" targetRef="lencana" />
    <bpmn:sequenceFlow id="f-pisah-riwayat" sourceRef="pisah" targetRef="riwayat" />
    <bpmn:sequenceFlow id="f-poin-gabung" sourceRef="poin" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-lencana-gabung" sourceRef="lencana" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-riwayat-gabung" sourceRef="riwayat" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-selesai" sourceRef="gabung" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_poin" name="Poin Reputasi" dataStoreRef="d_poin-store" />
    <bpmn:dataStoreReference id="d_lencana" name="Lencana" dataStoreRef="d_lencana-store" />
    <bpmn:dataStoreReference id="d_komen" name="Komentar" dataStoreRef="d_komen-store" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
