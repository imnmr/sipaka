tok 0.1 "Ubah Profil (Kelola Profil)"

pool p "Ubah Profil" process=ubah_profil
  start mulai "Perubahan profil diterima" message="Data profil baru"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  service valid "Validasi data profil"
  xor ok "Data profil valid?"
  service simpan "Simpan perubahan profil"
  send pesan "Kirim pesan kesalahan data profil" message="Pesan kesalahan profil"
  receive perbaiki "Terima data profil yang diperbaiki" message="Data profil diperbaiki"
  end tolak "Akses ditolak" message="Akses ditolak"
  end selesai "Profil diperbarui" message="Konfirmasi profil diperbarui"
  store d_profil "Profil Pengguna"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> valid "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow perbaiki -> valid -> ok
flow ok -> simpan "ya" when="profilValid"
flow ok -> pesan "tidak" default
flow simpan -> selesai
flow pesan -> perbaiki

message user -> mulai "Data profil baru"
message tolak -> user "Akses ditolak"
message selesai -> user "Konfirmasi profil diperbarui"
message pesan -> user "Pesan kesalahan profil"
message user -> perbaiki "Data profil diperbaiki"

writes simpan d_profil
