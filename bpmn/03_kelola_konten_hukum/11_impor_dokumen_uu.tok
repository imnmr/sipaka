tok 0.5 "Impor Dokumen UU (Kelola Konten Hukum)"

pool p "Impor Dokumen UU" process=impor_dokumen_uu
  send salah "Kirim daftar kesalahan metadata" message="Daftar kesalahan metadata"
  receive koreksi "Terima metadata yang diperbaiki" message="Metadata diperbaiki"
  start mulai "Berkas PDF UU diterima" message="Berkas PDF UU"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  service urai "Uraikan PDF UU"
  service valid "Validasi Metadata UU"
  xor metaok "Metadata valid dan lengkap?"
  service terbit "Terbitkan Dokumen UU"
  xor terbaca "PDF berhasil diuraikan?"
  service struktur "Ekstrak Struktur Dokumen"
  catch ulang "Admin mengunggah ulang PDF" message="PDF diunggah ulang"
  send gagalbaca "Kirim pesan PDF tidak terbaca" message="Pesan PDF tidak terbaca"
  eventgw tunggu1
  catch batal "Admin membatalkan impor" message="Batal impor"
  end dibatalkan "Impor dibatalkan"
  end selesai "Dokumen UU tersedia bagi pengguna" message="Konfirmasi publikasi UU"
  end tolak "Akses ditolak" message="Akses ditolak"
  store d_uu "Undang-Undang"

pool admin "Admin"

flow metaok -> salah "tidak" default
flow salah -> koreksi -> valid
flow mulai -> auth -> izin
flow izin -> urai "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow ulang -> urai -> terbaca
flow struktur -> valid -> metaok
flow metaok -> terbit "ya" when="metadataValid"
flow terbit -> selesai
flow terbaca -> struktur "ya" when="pdfTerbaca"
flow terbaca -> gagalbaca "tidak" default
flow tunggu1 -> ulang
flow gagalbaca -> tunggu1
flow tunggu1 -> batal -> dibatalkan

message admin -> mulai "Berkas PDF UU"
message tolak -> admin "Akses ditolak"
message gagalbaca -> admin "Pesan PDF tidak terbaca"
message admin -> ulang "PDF diunggah ulang"
message admin -> batal "Batal impor"
message salah -> admin "Daftar kesalahan metadata"
message admin -> koreksi "Metadata diperbaiki"
message selesai -> admin "Konfirmasi publikasi UU"

reads valid d_uu
writes terbit d_uu
