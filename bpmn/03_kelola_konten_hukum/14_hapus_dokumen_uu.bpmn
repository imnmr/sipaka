      <bpmndi:BPMNShape id="relasi_di" bpmnElement="relasi">
        <dc:Bounds x="1032" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
