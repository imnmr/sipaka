<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Hapus Dokumen UU (Kelola Konten Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_hapus_UU" name="Permintaan hapus UU" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Permintaan_konfirmasi_hapus" name="Permintaan konfirmasi hapus" />
  <bpmn:message id="Message_Konfirmasi_hapus" name="Konfirmasi hapus" />
  <bpmn:message id="Message_Batal_hapus" name="Batal hapus" />
  <bpmn:message id="Message_Konfirmasi_UU_dihapus" name="Konfirmasi UU dihapus" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Hapus Dokumen UU" processRef="hapus_dokumen_uu" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="Permintaan hapus UU" sourceRef="admin" targetRef="mulai" messageRef="Message_Permintaan_hapus_UU" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-minta-admin" name="Permintaan konfirmasi hapus" sourceRef="minta" targetRef="admin" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:messageFlow id="m-admin-ya" name="Konfirmasi hapus" sourceRef="admin" targetRef="ya" messageRef="Message_Konfirmasi_hapus" />
    <bpmn:messageFlow id="m-admin-tidak" name="Batal hapus" sourceRef="admin" targetRef="tidak" messageRef="Message_Batal_hapus" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi UU dihapus" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_UU_dihapus" />
  </bpmn:collaboration>
  <bpmn:process id="hapus_dokumen_uu" name="Hapus Dokumen UU (Kelola Konten Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan hapus UU diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_hapus_UU" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="cek" name="Periksa keterkaitan dokumen (amandemen, anotasi, rujukan forum)" />
    <bpmn:sendTask id="minta" name="Minta konfirmasi penghapusan" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="ya" name="Admin mengonfirmasi hapus">
      <bpmn:messageEventDefinition id="ya-def" messageRef="Message_Konfirmasi_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tidak" name="Admin membatalkan hapus">
      <bpmn:messageEventDefinition id="tidak-def" messageRef="Message_Batal_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="hapus" name="Hapus Dokumen UU" />
    <bpmn:serviceTask id="relasi" name="Perbarui relasi UU yang terkait" />
    <bpmn:endEvent id="selesai" name="Dokumen UU dihapus">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_UU_dihapus" />
    </bpmn:endEvent>
    <bpmn:endEvent id="batal" name="Penghapusan dibatalkan" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-cek" name="ya" sourceRef="izin" targetRef="cek">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-cek-minta" sourceRef="cek" targetRef="minta" />
    <bpmn:sequenceFlow id="f-minta-tunggu" sourceRef="minta" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-ya" sourceRef="tunggu" targetRef="ya" />
    <bpmn:sequenceFlow id="f-tunggu-tidak" sourceRef="tunggu" targetRef="tidak" />
    <bpmn:sequenceFlow id="f-ya-hapus" sourceRef="ya" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-hapus-relasi" sourceRef="hapus" targetRef="relasi" />
    <bpmn:sequenceFlow id="f-relasi-selesai" sourceRef="relasi" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-tidak-batal" sourceRef="tidak" targetRef="batal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1250" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="admin_di" bpmnElement="admin" isHorizontal="true">
        <dc:Bounds x="0" y="270" width="1250" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="60" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="14" width="56" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
