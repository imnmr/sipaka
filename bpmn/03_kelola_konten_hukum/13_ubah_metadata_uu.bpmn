<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ubah Metadata UU (Kelola Konten Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Perubahan_metadata_UU" name="Perubahan metadata UU" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konfirmasi_metadata_diperbarui" name="Konfirmasi metadata diperbarui" />
  <bpmn:message id="Message_Daftar_kesalahan_metadata" name="Daftar kesalahan metadata" />
  <bpmn:message id="Message_Metadata_diperbaiki" name="Metadata diperbaiki" />
  <bpmn:dataStore id="d_riw-store" name="Riwayat Perubahan UU" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Ubah Metadata UU" processRef="ubah_metadata_uu" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="Perubahan metadata UU" sourceRef="admin" targetRef="mulai" messageRef="Message_Perubahan_metadata_UU" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi metadata diperbarui" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_metadata_diperbarui" />
    <bpmn:messageFlow id="m-pesan-admin" name="Daftar kesalahan metadata" sourceRef="pesan" targetRef="admin" messageRef="Message_Daftar_kesalahan_metadata" />
    <bpmn:messageFlow id="m-admin-perbaiki" name="Metadata diperbaiki" sourceRef="admin" targetRef="perbaiki" messageRef="Message_Metadata_diperbaiki" />
  </bpmn:collaboration>
  <bpmn:process id="ubah_metadata_uu" name="Ubah Metadata UU (Kelola Konten Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Perubahan metadata diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Perubahan_metadata_UU" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="valid" name="Validasi perubahan metadata" />
    <bpmn:exclusiveGateway id="ok" name="Metadata valid?" default="f-ok-pesan" />
    <bpmn:serviceTask id="simpan" name="Simpan perubahan metadata">
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:targetRef>d_uu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="riwayat" name="Catat riwayat perubahan metadata">
      <bpmn:dataOutputAssociation id="riwayat-doa-2">
        <bpmn:targetRef>d_riw</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Metadata UU diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_metadata_diperbarui" />
    </bpmn:endEvent>
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="pesan" name="Kirim daftar kesalahan metadata" messageRef="Message_Daftar_kesalahan_metadata" />
    <bpmn:receiveTask id="perbaiki" name="Terima metadata yang diperbaiki" messageRef="Message_Metadata_diperbaiki" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-valid" name="ya" sourceRef="izin" targetRef="valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-perbaiki-valid" sourceRef="perbaiki" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-ok" sourceRef="valid" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-simpan" name="ya" sourceRef="ok" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">metadataValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-pesan" name="tidak" sourceRef="ok" targetRef="pesan" />
    <bpmn:sequenceFlow id="f-simpan-riwayat" sourceRef="simpan" targetRef="riwayat" />
    <bpmn:sequenceFlow id="f-riwayat-selesai" sourceRef="riwayat" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-pesan-perbaiki" sourceRef="pesan" targetRef="perbaiki" />
    <bpmn:dataStoreReference id="d_riw" name="Riwayat Perubahan UU" dataStoreRef="d_riw-store" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
