tok 0.5 "Jelaskan Undang-Undang (Asisten Riset AI)"

pool p "Jelaskan Undang-Undang" process=jelaskan_undang_undang
  start mulai "Permintaan penjelasan diterima" message="Pasal atau linimasa yang dijelaskan"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  xor jenis "Jenis penjelasan?"
  service makna "Jelaskan Makna Pasal"
  xor gabung
  call ai "Tangani Permintaan AI" process=tangani_permintaan_ai
  xor berhasil "Respons AI berhasil?"
  send hasil "Kirim penjelasan AI" message="Penjelasan AI"
  eventgw tunggu
  catch simpan "Pengguna meminta simpan ke repositori" message="Permintaan simpan ke repositori"
  call repo "Tambah Entri Repositori" process=tambah_entri_repositori
  end tersimpan "Penjelasan tersimpan di repositori"
  end tolak "Akses ditolak" message="Akses ditolak"
  end gagal "Penjelasan gagal dibuat" message="Pesan penjelasan gagal"
  catch tutup "Pengguna selesai membaca" message="Selesai membaca"
  end selesai "Penjelasan telah dibaca"
  sub ringkas "Ringkas Linimasa Amandemen"
    start r1 "Mulai meringkas linimasa"
    call r2 "Kelompokkan Amandemen per Tahun" process=lacak_amandemen doc="Langkah 'Kelompokkan Amandemen per Tahun' pada proses Lacak Amandemen"
    call r3 "Ambil Riwayat Perubahan" process=lacak_amandemen doc="Langkah 'Ambil Riwayat Perubahan' pada proses Lacak Amandemen"
    end r4 "Bahan linimasa siap"
  store d_uu "Undang-Undang"

pool user "Pengguna"

flow r1 -> r2 -> r3 -> r4
flow mulai -> auth -> izin
flow izin -> jenis "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow jenis -> makna "makna pasal" when="jenis = \"pasal\""
flow jenis -> ringkas "linimasa amandemen" default
flow makna -> gabung
flow ringkas -> gabung -> ai -> berhasil
flow berhasil -> hasil "ya" when="aiBerhasil"
flow berhasil -> gagal "tidak" default
flow hasil -> tunggu
flow tunggu -> simpan
flow tunggu -> tutup
flow simpan -> repo -> tersimpan
flow tutup -> selesai

message user -> mulai "Pasal atau linimasa yang dijelaskan"
message tolak -> user "Akses ditolak"
message gagal -> user "Pesan penjelasan gagal"
message hasil -> user "Penjelasan AI"
message user -> simpan "Permintaan simpan ke repositori"
message user -> tutup "Selesai membaca"

reads makna d_uu
