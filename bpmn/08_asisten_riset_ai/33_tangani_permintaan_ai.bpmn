<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Tangani Permintaan AI (Asisten Riset AI)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Prompt" name="Prompt" />
  <bpmn:message id="Message_Respons" name="Respons" />
  <bpmn:dataStore id="d_kuota-store" name="Kuota Penggunaan AI" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:dataStore id="d_cache-store" name="Cache Respons AI" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Tangani Permintaan AI" processRef="tangani_permintaan_ai" />
    <bpmn:participant id="ai" name="Layanan AI (penyedia eksternal)" />
    <bpmn:messageFlow id="m-kirim-ai" name="Prompt" sourceRef="kirim" targetRef="ai" messageRef="Message_Prompt" />
    <bpmn:messageFlow id="m-ai-terima" name="Respons" sourceRef="ai" targetRef="terima" messageRef="Message_Respons" />
  </bpmn:collaboration>
  <bpmn:process id="tangani_permintaan_ai" name="Tangani Permintaan AI (Asisten Riset AI)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan AI diterima dari fitur pemanggil" />
    <bpmn:serviceTask id="kuota" name="Periksa Kuota Penggunaan AI">
      <bpmn:ioSpecification id="kuota-io">
        <bpmn:dataInput id="kuota-in-1" name="Kuota Penggunaan AI" />
        <bpmn:dataOutput id="kuota-out-2" name="Kuota Penggunaan AI" />
        <bpmn:inputSet id="kuota-inputs">
          <bpmn:dataInputRefs>kuota-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="kuota-outputs">
          <bpmn:dataOutputRefs>kuota-out-2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="kuota-dia-1">
        <bpmn:sourceRef>d_kuota</bpmn:sourceRef>
        <bpmn:targetRef>kuota-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="kuota-doa-2">
        <bpmn:sourceRef>kuota-out-2</bpmn:sourceRef>
        <bpmn:targetRef>d_kuota</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="kuotaok" name="Kuota penggunaan masih tersedia?" default="f-kuotaok-habis" />
    <bpmn:serviceTask id="cache" name="Ambil Respons AI dari Cache">
      <bpmn:ioSpecification id="cache-io">
        <bpmn:dataInput id="cache-in-3" name="Cache Respons AI" />
        <bpmn:inputSet id="cache-inputs">
          <bpmn:dataInputRefs>cache-in-3</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="cache-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="cache-dia-3">
        <bpmn:sourceRef>d_cache</bpmn:sourceRef>
        <bpmn:targetRef>cache-in-3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ada" name="Respons ada di cache?" default="f-ada-prompt" />
    <bpmn:serviceTask id="prompt" name="Susun Prompt Konteks">
      <bpmn:ioSpecification id="prompt-io">
        <bpmn:dataInput id="prompt-in-4" name="Undang-Undang" />
        <bpmn:inputSet id="prompt-inputs">
          <bpmn:dataInputRefs>prompt-in-4</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="prompt-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="prompt-dia-4">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>prompt-in-4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="kirim" name="Kirim prompt ke layanan AI" messageRef="Message_Prompt" />
    <bpmn:receiveTask id="terima" name="Terima respons dari layanan AI" messageRef="Message_Respons" />
    <bpmn:exclusiveGateway id="berhasil" name="Layanan AI merespons dengan benar?" default="f-berhasil-gagal" />
    <bpmn:serviceTask id="simpan" name="Simpan Respons AI ke Cache">
      <bpmn:ioSpecification id="simpan-io">
        <bpmn:dataOutput id="simpan-out-5" name="Cache Respons AI" />
        <bpmn:inputSet id="simpan-inputs" />
        <bpmn:outputSet id="simpan-outputs">
          <bpmn:dataOutputRefs>simpan-out-5</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="simpan-doa-5">
        <bpmn:sourceRef>simpan-out-5</bpmn:sourceRef>
        <bpmn:targetRef>d_cache</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:serviceTask id="disclaimer" name="Sertakan Disclaimer AI" />
    <bpmn:endEvent id="selesai" name="Respons AI siap ditampilkan" />
    <bpmn:endEvent id="habis" name="Ditolak: kuota penggunaan AI habis" />
    <bpmn:endEvent id="gagal" name="Gagal: layanan AI tidak tersedia" />
    <bpmn:sequenceFlow id="f-mulai-kuota" sourceRef="mulai" targetRef="kuota" />
    <bpmn:sequenceFlow id="f-kuota-kuotaok" sourceRef="kuota" targetRef="kuotaok" />
    <bpmn:sequenceFlow id="f-kuotaok-cache" name="ya" sourceRef="kuotaok" targetRef="cache">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kuotaTersedia</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-kuotaok-habis" name="tidak" sourceRef="kuotaok" targetRef="habis" />
    <bpmn:sequenceFlow id="f-cache-ada" sourceRef="cache" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-gabung" name="ya" sourceRef="ada" targetRef="gabung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adaDiCache</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-prompt" name="tidak" sourceRef="ada" targetRef="prompt" />
    <bpmn:sequenceFlow id="f-prompt-kirim" sourceRef="prompt" targetRef="kirim" />
    <bpmn:sequenceFlow id="f-kirim-terima" sourceRef="kirim" targetRef="terima" />
    <bpmn:sequenceFlow id="f-terima-berhasil" sourceRef="terima" targetRef="berhasil" />
    <bpmn:sequenceFlow id="f-berhasil-simpan" name="ya" sourceRef="berhasil" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responsBerhasil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-berhasil-gagal" name="tidak" sourceRef="berhasil" targetRef="gagal" />
    <bpmn:sequenceFlow id="f-simpan-gabung" sourceRef="simpan" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-disclaimer" sourceRef="gabung" targetRef="disclaimer" />
    <bpmn:sequenceFlow id="f-disclaimer-selesai" sourceRef="disclaimer" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_kuota" name="Kuota Penggunaan AI" dataStoreRef="d_kuota-store" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
    <bpmn:dataStoreReference id="d_cache" name="Cache Respons AI" dataStoreRef="d_cache-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1670" height="290" />
