<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Cari dengan AI (Asisten Riset AI)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Pertanyaan_atau_kasus_dalam_bahasa_sehari_hari" name="Pertanyaan atau kasus dalam bahasa sehari-hari" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pesan_pencarian_AI_gagal" name="Pesan pencarian AI gagal" />
  <bpmn:message id="Message_Hasil_pencarian_AI" name="Hasil pencarian AI" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Cari dengan AI" processRef="cari_dengan_ai" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Pertanyaan atau kasus dalam bahasa sehari-hari" sourceRef="user" targetRef="mulai" messageRef="Message_Pertanyaan_atau_kasus_dalam_bahasa_sehari_hari" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-gagal-user" name="Pesan pencarian AI gagal" sourceRef="gagal" targetRef="user" messageRef="Message_Pesan_pencarian_AI_gagal" />
    <bpmn:messageFlow id="m-hasil-user" name="Hasil pencarian AI" sourceRef="hasil" targetRef="user" messageRef="Message_Hasil_pencarian_AI" />
  </bpmn:collaboration>
  <bpmn:process id="cari_dengan_ai" name="Cari dengan AI (Asisten Riset AI)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Pertanyaan bebas diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Pertanyaan_atau_kasus_dalam_bahasa_sehari_hari" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="tafsir" name="Tafsirkan Kueri Pengguna" />
    <bpmn:callActivity id="filter" name="Terapkan Filter Pencarian" calledElement="cari_undang_undang">
      <bpmn:documentation>Langkah 'Terapkan Filter Pencarian' pada proses Cari Undang-Undang</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:callActivity id="ai" name="Tangani Permintaan AI" calledElement="tangani_permintaan_ai" />
    <bpmn:exclusiveGateway id="berhasil" name="Respons AI berhasil?" default="f-berhasil-gagal" />
    <bpmn:serviceTask id="urut" name="Urutkan Hasil Pencarian AI">
      <bpmn:ioSpecification id="urut-io">
        <bpmn:dataInput id="urut-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="urut-inputs">
          <bpmn:dataInputRefs>urut-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="urut-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="urut-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>urut-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="hasil" name="Kirim hasil pencarian AI" messageRef="Message_Hasil_pencarian_AI" />
    <bpmn:endEvent id="selesai" name="Hasil pencarian AI terkirim" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gagal" name="Pencarian AI gagal">
      <bpmn:messageEventDefinition id="gagal-def" messageRef="Message_Pesan_pencarian_AI_gagal" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-tafsir" name="ya" sourceRef="izin" targetRef="tafsir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-tafsir-filter" sourceRef="tafsir" targetRef="filter" />
    <bpmn:sequenceFlow id="f-filter-ai" sourceRef="filter" targetRef="ai" />
    <bpmn:sequenceFlow id="f-ai-berhasil" sourceRef="ai" targetRef="berhasil" />
    <bpmn:sequenceFlow id="f-berhasil-urut" name="ya" sourceRef="berhasil" targetRef="urut">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aiBerhasil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-berhasil-gagal" name="tidak" sourceRef="berhasil" targetRef="gagal" />
    <bpmn:sequenceFlow id="f-urut-hasil" sourceRef="urut" targetRef="hasil" />
    <bpmn:sequenceFlow id="f-hasil-selesai" sourceRef="hasil" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1320" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
