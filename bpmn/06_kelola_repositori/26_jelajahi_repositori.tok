tok 0.5 "Jelajahi Repositori (Kelola Repositori)"

pool p "Jelajahi Repositori" process=jelajahi_repositori
  start mulai "Filter dan kata kunci diterima" message="Filter dan kata kunci repositori"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  service saring "Saring Entri Repositori"
  xor ada "Ada entri yang cocok?"
  send tampil "Tampilkan daftar entri (milik sendiri dan yang dibagikan)" message="Daftar entri repositori"
  end selesai "Daftar entri terkirim"
  send kosong "Tampilkan pesan tidak ada entri" message="Pesan tidak ada entri"
  end nihil "Tidak ada entri yang cocok"
  end tolak "Akses ditolak" message="Akses ditolak"
  store d_entri "Entri Repositori"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> saring "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow saring -> ada
flow ada -> tampil "ya" when="jumlahEntri > 0"
flow ada -> kosong "tidak" default
flow tampil -> selesai
flow kosong -> nihil

message user -> mulai "Filter dan kata kunci repositori"
message tolak -> user "Akses ditolak"
message tampil -> user "Daftar entri repositori"
message kosong -> user "Pesan tidak ada entri"

reads saring d_entri
