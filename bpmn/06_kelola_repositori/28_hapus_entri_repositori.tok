tok 0.1 "Hapus Entri Repositori (Kelola Repositori)"

pool p "Hapus Entri Repositori" process=hapus_entri_repositori
  start mulai "Permintaan hapus entri diterima" message="Permintaan hapus entri"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  xor pemilik "Pengguna pemilik entri?"
  send minta "Minta konfirmasi penghapusan" message="Permintaan konfirmasi hapus"
  eventgw tunggu
  catch ya "Pengguna mengonfirmasi hapus" message="Konfirmasi hapus"
  service hapus "Hapus Entri Repositori"
  end selesai "Entri dihapus" message="Konfirmasi entri dihapus"
  end tolak "Akses ditolak" message="Akses ditolak"
  end bukan "Penghapusan ditolak: bukan pemilik" message="Penghapusan ditolak"
  catch tidak "Pengguna membatalkan hapus" message="Batal hapus"
  end batal "Penghapusan dibatalkan"
  store d_entri "Entri Repositori"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> pemilik "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow pemilik -> minta "ya" when="pemilik"
flow pemilik -> bukan "tidak" default
flow minta -> tunggu
flow tunggu -> ya
flow tunggu -> tidak
flow ya -> hapus -> selesai
flow tidak -> batal

message user -> mulai "Permintaan hapus entri"
message tolak -> user "Akses ditolak"
message bukan -> user "Penghapusan ditolak"
message minta -> user "Permintaan konfirmasi hapus"
message user -> ya "Konfirmasi hapus"
message user -> tidak "Batal hapus"
message selesai -> user "Konfirmasi entri dihapus"

writes hapus d_entri
