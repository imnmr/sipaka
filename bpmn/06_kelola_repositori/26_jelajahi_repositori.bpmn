        <di:waypoint x="856" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="781" y="456" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="saring-dia-1_di" bpmnElement="saring-dia-1">
        <di:waypoint x="606" y="255" />
        <di:waypoint x="606" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-mulai-auth_di" bpmnElement="f-mulai-auth">
        <di:waypoint x="256" y="150" />
        <di:waypoint x="306" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-auth-izin_di" bpmnElement="f-auth-izin">
