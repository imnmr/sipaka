        <dc:Bounds x="706" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="96" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tampil_di" bpmnElement="tampil">
        <dc:Bounds x="806" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="956" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="173" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kosong_di" bpmnElement="kosong">
        <dc:Bounds x="806" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nihil_di" bpmnElement="nihil">
        <dc:Bounds x="956" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="932" y="303" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tolak_di" bpmnElement="tolak">
        <dc:Bounds x="463" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="383" y="273" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_entri_di" bpmnElement="d_entri">
        <dc:Bounds x="581" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="561" y="313" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="238" y="490" />
        <di:waypoint x="238" y="168" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="238" y="457" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tolak-user_di" bpmnElement="m-tolak-user">
        <di:waypoint x="481" y="298" />
        <di:waypoint x="481" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="463" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tampil-user_di" bpmnElement="m-tampil-user">
        <di:waypoint x="906" y="158" />
