<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Jelajahi Repositori (Kelola Repositori)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Filter_dan_kata_kunci_repositori" name="Filter dan kata kunci repositori" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Daftar_entri_repositori" name="Daftar entri repositori" />
  <bpmn:message id="Message_Pesan_tidak_ada_entri" name="Pesan tidak ada entri" />
  <bpmn:dataStore id="d_entri-store" name="Entri Repositori" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Jelajahi Repositori" processRef="jelajahi_repositori" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Filter dan kata kunci repositori" sourceRef="user" targetRef="mulai" messageRef="Message_Filter_dan_kata_kunci_repositori" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-tampil-user" name="Daftar entri repositori" sourceRef="tampil" targetRef="user" messageRef="Message_Daftar_entri_repositori" />
    <bpmn:messageFlow id="m-kosong-user" name="Pesan tidak ada entri" sourceRef="kosong" targetRef="user" messageRef="Message_Pesan_tidak_ada_entri" />
  </bpmn:collaboration>
  <bpmn:process id="jelajahi_repositori" name="Jelajahi Repositori (Kelola Repositori)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Filter dan kata kunci diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Filter_dan_kata_kunci_repositori" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="saring" name="Saring Entri Repositori">
      <bpmn:ioSpecification id="saring-io">
        <bpmn:dataInput id="saring-in-1" name="Entri Repositori" />
        <bpmn:inputSet id="saring-inputs">
          <bpmn:dataInputRefs>saring-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="saring-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="saring-dia-1">
        <bpmn:sourceRef>d_entri</bpmn:sourceRef>
        <bpmn:targetRef>saring-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ada" name="Ada entri yang cocok?" default="f-ada-kosong" />
    <bpmn:sendTask id="tampil" name="Tampilkan daftar entri (milik sendiri dan yang dibagikan)" messageRef="Message_Daftar_entri_repositori" />
    <bpmn:endEvent id="selesai" name="Daftar entri terkirim" />
    <bpmn:sendTask id="kosong" name="Tampilkan pesan tidak ada entri" messageRef="Message_Pesan_tidak_ada_entri" />
    <bpmn:endEvent id="nihil" name="Tidak ada entri yang cocok" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-saring" name="ya" sourceRef="izin" targetRef="saring">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-saring-ada" sourceRef="saring" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-tampil" name="ya" sourceRef="ada" targetRef="tampil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jumlahEntri &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-kosong" name="tidak" sourceRef="ada" targetRef="kosong" />
    <bpmn:sequenceFlow id="f-tampil-selesai" sourceRef="tampil" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-kosong-nihil" sourceRef="kosong" targetRef="nihil" />
    <bpmn:dataStoreReference id="d_entri" name="Entri Repositori" dataStoreRef="d_entri-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="870" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="160" y="490" width="870" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="193" y="101" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auth_di" bpmnElement="auth">
        <dc:Bounds x="306" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="izin_di" bpmnElement="izin" isMarkerVisible="true">
        <dc:Bounds x="456" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="453" y="96" width="56" height="27" />
