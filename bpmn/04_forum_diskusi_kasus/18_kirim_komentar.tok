tok 0.5 "Kirim Komentar (Forum Diskusi Kasus)"

pool p "Kirim Komentar" process=kirim_komentar
  start mulai "Komentar diterima" message="Isi komentar"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  service valid "Validasi Isi Komentar"
  xor ok "Komentar valid?"
  service simpan "Simpan komentar ke thread"
  call poin "Beri Poin Reputasi" process=kelola_reputasi doc="Langkah 'Beri Poin Reputasi' pada proses Kelola Reputasi"
  end selesai "Komentar tampil di thread" message="Konfirmasi komentar tampil"
  send pesan "Kirim pesan kesalahan isi komentar" message="Pesan kesalahan komentar"
  receive perbaiki "Terima komentar yang diperbaiki" message="Komentar diperbaiki"
  end tolak "Akses ditolak" message="Akses ditolak"
  store d_komen "Komentar"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> valid "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow perbaiki -> valid -> ok
flow ok -> simpan "ya" when="komentarValid"
flow ok -> pesan "tidak" default
flow simpan -> poin -> selesai
flow pesan -> perbaiki

message user -> mulai "Isi komentar"
message tolak -> user "Akses ditolak"
message selesai -> user "Konfirmasi komentar tampil"
message pesan -> user "Pesan kesalahan komentar"
message user -> perbaiki "Komentar diperbaiki"

writes simpan d_komen
