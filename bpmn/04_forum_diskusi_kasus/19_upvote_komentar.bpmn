<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Upvote Komentar (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_upvote" name="Permintaan upvote" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Upvote_ditolak" name="Upvote ditolak" />
  <bpmn:message id="Message_Status_upvote" name="Status upvote" />
  <bpmn:message id="Message_Status_upvote_dicabut" name="Status upvote dicabut" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Upvote Komentar" processRef="upvote_komentar" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan upvote" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_upvote" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-tolaksendiri-user" name="Upvote ditolak" sourceRef="tolaksendiri" targetRef="user" messageRef="Message_Upvote_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Status upvote" sourceRef="selesai" targetRef="user" messageRef="Message_Status_upvote" />
    <bpmn:messageFlow id="m-selesai2-user" name="Status upvote dicabut" sourceRef="selesai2" targetRef="user" messageRef="Message_Status_upvote_dicabut" />
  </bpmn:collaboration>
  <bpmn:process id="upvote_komentar" name="Upvote Komentar (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan upvote diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_upvote" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sendiri" name="Komentar milik pengguna sendiri?" default="f-sendiri-alih" />
    <bpmn:endEvent id="tolaksendiri" name="Upvote ditolak">
      <bpmn:messageEventDefinition id="tolaksendiri-def" messageRef="Message_Upvote_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="alih" name="Alihkan Status Upvote" />
    <bpmn:exclusiveGateway id="baru" name="Upvote ditambahkan (bukan dicabut)?" default="f-baru-selesai2" />
    <bpmn:callActivity id="poin" name="Beri Poin Reputasi" calledElement="kelola_reputasi">
      <bpmn:documentation>Langkah 'Beri Poin Reputasi' pada proses Kelola Reputasi (untuk penulis komentar)</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:endEvent id="selesai" name="Status upvote diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Status_upvote" />
    </bpmn:endEvent>
    <bpmn:endEvent id="selesai2" name="Upvote dicabut">
      <bpmn:messageEventDefinition id="selesai2-def" messageRef="Message_Status_upvote_dicabut" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-sendiri" name="ya" sourceRef="izin" targetRef="sendiri">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-sendiri-tolaksendiri" name="ya" sourceRef="sendiri" targetRef="tolaksendiri">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">komentarSendiri</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sendiri-alih" name="tidak" sourceRef="sendiri" targetRef="alih" />
    <bpmn:sequenceFlow id="f-alih-baru" sourceRef="alih" targetRef="baru" />
    <bpmn:sequenceFlow id="f-baru-poin" name="ya" sourceRef="baru" targetRef="poin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">upvoteBaru</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-baru-selesai2" name="tidak" sourceRef="baru" targetRef="selesai2" />
    <bpmn:sequenceFlow id="f-poin-selesai" sourceRef="poin" targetRef="selesai" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
