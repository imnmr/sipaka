        <bpmndi:BPMNLabel>
          <dc:Bounds x="237" y="370" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tolak-user_di" bpmnElement="m-tolak-user">
        <di:waypoint x="481" y="298" />
        <di:waypoint x="481" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="375" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-daftar-user_di" bpmnElement="m-daftar-user">
        <di:waypoint x="856" y="190" />
