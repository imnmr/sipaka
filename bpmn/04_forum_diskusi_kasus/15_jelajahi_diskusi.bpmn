        <bpmndi:BPMNLabel>
          <dc:Bounds x="697" y="108" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="daftar_di" bpmnElement="daftar">
        <dc:Bounds x="806" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="956" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="934" y="173" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kosong_di" bpmnElement="kosong">
        <dc:Bounds x="806" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nihil_di" bpmnElement="nihil">
        <dc:Bounds x="956" y="262" width="36" height="36" />
