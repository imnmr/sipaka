<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Jelajahi Diskusi (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Pilihan_kategori_hukum" name="Pilihan kategori hukum" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Daftar_diskusi" name="Daftar diskusi" />
  <bpmn:message id="Message_Pesan_belum_ada_diskusi" name="Pesan belum ada diskusi" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Jelajahi Diskusi" processRef="jelajahi_diskusi" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Pilihan kategori hukum" sourceRef="user" targetRef="mulai" messageRef="Message_Pilihan_kategori_hukum" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-daftar-user" name="Daftar diskusi" sourceRef="daftar" targetRef="user" messageRef="Message_Daftar_diskusi" />
    <bpmn:messageFlow id="m-kosong-user" name="Pesan belum ada diskusi" sourceRef="kosong" targetRef="user" messageRef="Message_Pesan_belum_ada_diskusi" />
  </bpmn:collaboration>
  <bpmn:process id="jelajahi_diskusi" name="Jelajahi Diskusi (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Pilihan kategori diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Pilihan_kategori_hukum" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="saring" name="Saring Berdasarkan Kategori Hukum">
      <bpmn:ioSpecification id="saring-io">
        <bpmn:dataInput id="saring-in-1" name="Thread Diskusi" />
        <bpmn:inputSet id="saring-inputs">
          <bpmn:dataInputRefs>saring-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="saring-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="saring-dia-1">
        <bpmn:sourceRef>d_thread</bpmn:sourceRef>
        <bpmn:targetRef>saring-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ada" name="Ada diskusi?" default="f-ada-kosong" />
    <bpmn:sendTask id="daftar" name="Tampilkan Daftar Diskusi" messageRef="Message_Daftar_diskusi">
      <bpmn:ioSpecification id="daftar-io">
        <bpmn:dataInput id="daftar-in-2" name="Thread Diskusi" />
        <bpmn:inputSet id="daftar-inputs">
          <bpmn:dataInputRefs>daftar-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="daftar-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="daftar-dia-2">
        <bpmn:sourceRef>d_thread</bpmn:sourceRef>
        <bpmn:targetRef>daftar-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:endEvent id="selesai" name="Daftar diskusi terkirim" />
    <bpmn:sendTask id="kosong" name="Tampilkan pesan belum ada diskusi" messageRef="Message_Pesan_belum_ada_diskusi" />
    <bpmn:endEvent id="nihil" name="Tidak ada diskusi pada kategori ini" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-saring" name="ya" sourceRef="izin" targetRef="saring">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-saring-ada" sourceRef="saring" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-daftar" name="ya" sourceRef="ada" targetRef="daftar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jumlahDiskusi &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-kosong" name="tidak" sourceRef="ada" targetRef="kosong" />
    <bpmn:sequenceFlow id="f-daftar-selesai" sourceRef="daftar" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-kosong-nihil" sourceRef="kosong" targetRef="nihil" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="870" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="160" y="400" width="870" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="132" width="36" height="36" />
