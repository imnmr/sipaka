        <di:waypoint x="556" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="135" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-izin-tolak_di" bpmnElement="f-izin-tolak">
