        <di:waypoint x="481" y="262" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="188" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-perbaiki-valid_di" bpmnElement="f-perbaiki-valid">
        <di:waypoint x="1006" y="240" />
        <di:waypoint x="1006" y="210" />
        <di:waypoint x="606" y="210" />
        <di:waypoint x="606" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-valid-ok_di" bpmnElement="f-valid-ok">
        <di:waypoint x="656" y="150" />
        <di:waypoint x="706" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-ok-simpan_di" bpmnElement="f-ok-simpan">
        <di:waypoint x="756" y="150" />
        <di:waypoint x="806" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="764" y="135" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-ok-pesan_di" bpmnElement="f-ok-pesan">
        <di:waypoint x="731" y="175" />
        <di:waypoint x="731" y="280" />
        <di:waypoint x="806" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="736" y="188" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-simpan-poin_di" bpmnElement="f-simpan-poin">
        <di:waypoint x="906" y="150" />
        <di:waypoint x="956" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-poin-selesai_di" bpmnElement="f-poin-selesai">
        <di:waypoint x="1056" y="150" />
        <di:waypoint x="1106" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-pesan-perbaiki_di" bpmnElement="f-pesan-perbaiki">
        <di:waypoint x="906" y="280" />
        <di:waypoint x="956" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
