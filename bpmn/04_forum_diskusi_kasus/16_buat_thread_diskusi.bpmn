<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Buat Thread Diskusi (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Judul_dan_isi_thread" name="Judul dan isi thread" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konfirmasi_thread_terbit" name="Konfirmasi thread terbit" />
  <bpmn:message id="Message_Pesan_kesalahan_isi_thread" name="Pesan kesalahan isi thread" />
  <bpmn:message id="Message_Isi_thread_diperbaiki" name="Isi thread diperbaiki" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Buat Thread Diskusi" processRef="buat_thread_diskusi" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Judul dan isi thread" sourceRef="user" targetRef="mulai" messageRef="Message_Judul_dan_isi_thread" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi thread terbit" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_thread_terbit" />
    <bpmn:messageFlow id="m-pesan-user" name="Pesan kesalahan isi thread" sourceRef="pesan" targetRef="user" messageRef="Message_Pesan_kesalahan_isi_thread" />
    <bpmn:messageFlow id="m-user-perbaiki" name="Isi thread diperbaiki" sourceRef="user" targetRef="perbaiki" messageRef="Message_Isi_thread_diperbaiki" />
  </bpmn:collaboration>
  <bpmn:process id="buat_thread_diskusi" name="Buat Thread Diskusi (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Judul dan isi thread diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Judul_dan_isi_thread" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:serviceTask id="tipe" name="Pilih Tipe Thread" />
    <bpmn:serviceTask id="kategori" name="Tetapkan Kategori Hukum" />
    <bpmn:exclusiveGateway id="tautan" name="Menautkan UU?" default="f-tautan-gabung" />
    <bpmn:callActivity id="cari" name="Cari Undang-Undang" calledElement="cari_undang_undang" />
    <bpmn:serviceTask id="tautkan" name="Tautkan Rujukan UU" />
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:serviceTask id="valid" name="Validasi Isi Thread" />
    <bpmn:exclusiveGateway id="ok" name="Isi thread valid?" default="f-ok-pesan" />
    <bpmn:serviceTask id="simpan" name="Terbitkan thread">
      <bpmn:ioSpecification id="simpan-io">
        <bpmn:dataOutput id="simpan-out-1" name="Thread Diskusi" />
        <bpmn:inputSet id="simpan-inputs" />
        <bpmn:outputSet id="simpan-outputs">
          <bpmn:dataOutputRefs>simpan-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:sourceRef>simpan-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_thread</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="poin" name="Beri Poin Reputasi" calledElement="kelola_reputasi">
      <bpmn:documentation>Langkah 'Beri Poin Reputasi' pada proses Kelola Reputasi</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:endEvent id="selesai" name="Thread diterbitkan">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_thread_terbit" />
    </bpmn:endEvent>
    <bpmn:sendTask id="pesan" name="Kirim pesan kesalahan isi thread" messageRef="Message_Pesan_kesalahan_isi_thread" />
    <bpmn:receiveTask id="perbaiki" name="Terima isi thread yang diperbaiki" messageRef="Message_Isi_thread_diperbaiki" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-tipe" name="ya" sourceRef="izin" targetRef="tipe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-tipe-kategori" sourceRef="tipe" targetRef="kategori" />
    <bpmn:sequenceFlow id="f-kategori-tautan" sourceRef="kategori" targetRef="tautan" />
    <bpmn:sequenceFlow id="f-tautan-cari" name="ya" sourceRef="tautan" targetRef="cari">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tautkanUU</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-tautan-gabung" name="tidak" sourceRef="tautan" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-cari-tautkan" sourceRef="cari" targetRef="tautkan" />
    <bpmn:sequenceFlow id="f-tautkan-gabung" sourceRef="tautkan" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-valid" sourceRef="gabung" targetRef="valid" />
    <bpmn:sequenceFlow id="f-perbaiki-valid" sourceRef="perbaiki" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-ok" sourceRef="valid" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-simpan" name="ya" sourceRef="ok" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">threadValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-pesan" name="tidak" sourceRef="ok" targetRef="pesan" />
    <bpmn:sequenceFlow id="f-simpan-poin" sourceRef="simpan" targetRef="poin" />
    <bpmn:sequenceFlow id="f-poin-selesai" sourceRef="poin" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-pesan-perbaiki" sourceRef="pesan" targetRef="perbaiki" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
