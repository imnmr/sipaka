<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Kelola Glosarium (Glosarium Latin)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Aksi_dan_data_istilah_glosarium" name="Aksi dan data istilah glosarium" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pesan_kesalahan_data_istilah" name="Pesan kesalahan data istilah" />
  <bpmn:message id="Message_Data_istilah_diperbaiki" name="Data istilah diperbaiki" />
  <bpmn:message id="Message_Permintaan_konfirmasi_hapus" name="Permintaan konfirmasi hapus" />
  <bpmn:message id="Message_Konfirmasi_hapus" name="Konfirmasi hapus" />
  <bpmn:message id="Message_Batal_hapus" name="Batal hapus" />
  <bpmn:message id="Message_Konfirmasi_glosarium_diperbarui" name="Konfirmasi glosarium diperbarui" />
  <bpmn:dataStore id="d_istilah-store" name="Istilah Latin" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Kelola Glosarium" processRef="kelola_glosarium" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="Aksi dan data istilah glosarium" sourceRef="admin" targetRef="mulai" messageRef="Message_Aksi_dan_data_istilah_glosarium" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-pesan-admin" name="Pesan kesalahan data istilah" sourceRef="pesan" targetRef="admin" messageRef="Message_Pesan_kesalahan_data_istilah" />
    <bpmn:messageFlow id="m-admin-perbaiki" name="Data istilah diperbaiki" sourceRef="admin" targetRef="perbaiki" messageRef="Message_Data_istilah_diperbaiki" />
    <bpmn:messageFlow id="m-minta-admin" name="Permintaan konfirmasi hapus" sourceRef="minta" targetRef="admin" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:messageFlow id="m-admin-ya" name="Konfirmasi hapus" sourceRef="admin" targetRef="ya" messageRef="Message_Konfirmasi_hapus" />
    <bpmn:messageFlow id="m-admin-tidak" name="Batal hapus" sourceRef="admin" targetRef="tidak" messageRef="Message_Batal_hapus" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi glosarium diperbarui" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_glosarium_diperbarui" />
  </bpmn:collaboration>
  <bpmn:process id="kelola_glosarium" name="Kelola Glosarium (Glosarium Latin)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan kelola glosarium diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Aksi_dan_data_istilah_glosarium" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:exclusiveGateway id="aksi" name="Aksi glosarium?" default="f-aksi-minta" />
    <bpmn:serviceTask id="valid" name="Validasi data istilah (tidak duplikat, definisi terisi)">
      <bpmn:property id="valid-in-1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="valid-dia-1">
        <bpmn:sourceRef>d_istilah</bpmn:sourceRef>
        <bpmn:targetRef>valid-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok" name="Data istilah valid?" default="f-ok-pesan" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="minta" name="Minta konfirmasi penghapusan istilah" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:sendTask id="pesan" name="Kirim pesan kesalahan data istilah" messageRef="Message_Pesan_kesalahan_data_istilah" />
    <bpmn:receiveTask id="perbaiki" name="Terima data istilah yang diperbaiki" messageRef="Message_Data_istilah_diperbaiki" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="ya" name="Admin mengonfirmasi hapus">
      <bpmn:messageEventDefinition id="ya-def" messageRef="Message_Konfirmasi_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tidak" name="Admin membatalkan hapus">
      <bpmn:messageEventDefinition id="tidak-def" messageRef="Message_Batal_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="hapus" name="Hapus Istilah Glosarium">
      <bpmn:dataOutputAssociation id="hapus-doa-4">
        <bpmn:targetRef>d_istilah</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:endEvent id="selesai" name="Glosarium diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_glosarium_diperbarui" />
    </bpmn:endEvent>
    <bpmn:endEvent id="batal" name="Penghapusan dibatalkan" />
    <bpmn:serviceTask id="tambah" name="Tambah Istilah Glosarium">
      <bpmn:dataOutputAssociation id="tambah-doa-2">
        <bpmn:targetRef>d_istilah</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ubah" name="Ubah Istilah Glosarium">
      <bpmn:dataOutputAssociation id="ubah-doa-3">
        <bpmn:targetRef>d_istilah</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-aksi" name="ya" sourceRef="izin" targetRef="aksi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-aksi-valid" name="tambah atau ubah" sourceRef="aksi" targetRef="valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "tambah" or aksi = "ubah"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-minta" name="hapus" sourceRef="aksi" targetRef="minta" />
    <bpmn:sequenceFlow id="f-perbaiki-valid" sourceRef="perbaiki" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-ok" sourceRef="valid" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-tambah" name="ya, tambah" sourceRef="ok" targetRef="tambah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "tambah"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-ubah" name="ya, ubah" sourceRef="ok" targetRef="ubah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "ubah"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-pesan" name="tidak" sourceRef="ok" targetRef="pesan" />
    <bpmn:sequenceFlow id="f-minta-tunggu" sourceRef="minta" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-pesan-perbaiki" sourceRef="pesan" targetRef="perbaiki" />
    <bpmn:sequenceFlow id="f-tunggu-ya" sourceRef="tunggu" targetRef="ya" />
    <bpmn:sequenceFlow id="f-tunggu-tidak" sourceRef="tunggu" targetRef="tidak" />
    <bpmn:sequenceFlow id="f-ya-hapus" sourceRef="ya" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-tidak-batal" sourceRef="tidak" targetRef="batal" />
    <bpmn:sequenceFlow id="f-hapus-gabung" sourceRef="hapus" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-tambah-gabung" sourceRef="tambah" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-ubah-gabung" sourceRef="ubah" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-selesai" sourceRef="gabung" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_istilah" name="Istilah Latin" dataStoreRef="d_istilah-store" />
  </bpmn:process>
