<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Tampilkan Popup Istilah (Glosarium Latin)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Klik_istilah_Latin" name="Klik istilah Latin" />
  <bpmn:message id="Message_Popup_definisi_istilah" name="Popup definisi istilah" />
  <bpmn:message id="Message_Pesan_definisi_belum_tersedia" name="Pesan definisi belum tersedia" />
  <bpmn:dataStore id="d_istilah-store" name="Istilah Latin" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Tampilkan Popup Istilah" processRef="tampilkan_popup_istilah" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Klik istilah Latin" sourceRef="user" targetRef="mulai" messageRef="Message_Klik_istilah_Latin" />
    <bpmn:messageFlow id="m-tampil-user" name="Popup definisi istilah" sourceRef="tampil" targetRef="user" messageRef="Message_Popup_definisi_istilah" />
    <bpmn:messageFlow id="m-kosong-user" name="Pesan definisi belum tersedia" sourceRef="kosong" targetRef="user" messageRef="Message_Pesan_definisi_belum_tersedia" />
  </bpmn:collaboration>
  <bpmn:process id="tampilkan_popup_istilah" name="Tampilkan Popup Istilah (Glosarium Latin)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Klik istilah Latin diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Klik_istilah_Latin" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="cari" name="Cari Definisi Istilah">
      <bpmn:ioSpecification id="cari-io">
        <bpmn:dataInput id="cari-in-1" name="Istilah Latin" />
        <bpmn:inputSet id="cari-inputs">
          <bpmn:dataInputRefs>cari-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="cari-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="cari-dia-1">
        <bpmn:sourceRef>d_istilah</bpmn:sourceRef>
        <bpmn:targetRef>cari-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ada" name="Definisi ditemukan?" default="f-ada-kosong" />
    <bpmn:serviceTask id="susun" name="Susun Popup Istilah" />
    <bpmn:sendTask id="tampil" name="Kirim popup definisi istilah" messageRef="Message_Popup_definisi_istilah" />
    <bpmn:sendTask id="kosong" name="Tampilkan pesan definisi belum tersedia" messageRef="Message_Pesan_definisi_belum_tersedia" />
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:endEvent id="selesai" name="Popup istilah ditampilkan" />
    <bpmn:sequenceFlow id="f-mulai-cari" sourceRef="mulai" targetRef="cari" />
    <bpmn:sequenceFlow id="f-cari-ada" sourceRef="cari" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-susun" name="ya" sourceRef="ada" targetRef="susun">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">definisiAda</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-kosong" name="tidak" sourceRef="ada" targetRef="kosong" />
    <bpmn:sequenceFlow id="f-susun-tampil" sourceRef="susun" targetRef="tampil" />
    <bpmn:sequenceFlow id="f-tampil-gabung" sourceRef="tampil" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-kosong-gabung" sourceRef="kosong" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-selesai" sourceRef="gabung" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_istilah" name="Istilah Latin" dataStoreRef="d_istilah-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="870" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="160" y="390" width="870" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="193" y="102" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cari_di" bpmnElement="cari">
        <dc:Bounds x="306" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ada_di" bpmnElement="ada" isMarkerVisible="true">
        <dc:Bounds x="456" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="446" y="98" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="susun_di" bpmnElement="susun">
        <dc:Bounds x="556" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tampil_di" bpmnElement="tampil">
        <dc:Bounds x="706" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kosong_di" bpmnElement="kosong">
        <dc:Bounds x="556" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gabung_di" bpmnElement="gabung" isMarkerVisible="true">
        <dc:Bounds x="856" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="956" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="937" y="173" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_istilah_di" bpmnElement="d_istilah">
        <dc:Bounds x="331" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="319" y="310" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="238" y="390" />
        <di:waypoint x="238" y="168" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="227" y="367" width="111" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tampil-user_di" bpmnElement="m-tampil-user">
        <di:waypoint x="756" y="190" />
        <di:waypoint x="756" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="360" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-kosong-user_di" bpmnElement="m-kosong-user">
        <di:waypoint x="606" y="320" />
        <di:waypoint x="606" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="522" y="360" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cari-dia-1_di" bpmnElement="cari-dia-1">
        <di:waypoint x="356" y="255" />
        <di:waypoint x="356" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-mulai-cari_di" bpmnElement="f-mulai-cari">
        <di:waypoint x="256" y="150" />
        <di:waypoint x="306" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-cari-ada_di" bpmnElement="f-cari-ada">
        <di:waypoint x="406" y="150" />
        <di:waypoint x="456" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-ada-susun_di" bpmnElement="f-ada-susun">
        <di:waypoint x="506" y="150" />
        <di:waypoint x="556" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="134" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-ada-kosong_di" bpmnElement="f-ada-kosong">
        <di:waypoint x="481" y="175" />
        <di:waypoint x="481" y="280" />
        <di:waypoint x="556" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="188" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-susun-tampil_di" bpmnElement="f-susun-tampil">
        <di:waypoint x="656" y="150" />
        <di:waypoint x="706" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-tampil-gabung_di" bpmnElement="f-tampil-gabung">
        <di:waypoint x="806" y="150" />
        <di:waypoint x="856" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-kosong-gabung_di" bpmnElement="f-kosong-gabung">
        <di:waypoint x="656" y="280" />
        <di:waypoint x="881" y="280" />
        <di:waypoint x="881" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-gabung-selesai_di" bpmnElement="f-gabung-selesai">
        <di:waypoint x="906" y="150" />
        <di:waypoint x="956" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
