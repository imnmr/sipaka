<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lacak Amandemen (Pelacak Dokumen Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:message id="Message_Permintaan_lacak_amandemen" name="Permintaan lacak amandemen" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Linimasa_amandemen" name="Linimasa amandemen" />
  <bpmn:message id="Message_Teks_berwarna" name="Teks berwarna" />
  <bpmn:message id="Message_Pilih_tahun_linimasa" name="Pilih tahun linimasa" />
  <bpmn:message id="Message_Klik_teks_berwarna" name="Klik teks berwarna" />
  <bpmn:message id="Message_Buka_graf_relasi" name="Buka graf relasi" />
  <bpmn:message id="Message_Tutup_mode_lacak" name="Tutup mode lacak" />
  <bpmn:message id="Message_Teks_versi_terpilih" name="Teks versi terpilih" />
  <bpmn:message id="Message_Tampilan_berdampingan" name="Tampilan berdampingan" />
  <bpmn:message id="Message_Graf_relasi_UU" name="Graf relasi UU" />
  <bpmn:dataStore id="d_riw-store" name="Riwayat Perubahan UU" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Lacak Amandemen" processRef="lacak_amandemen" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan lacak amandemen" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_lacak_amandemen" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-l3-user" name="Linimasa amandemen" sourceRef="l3" targetRef="user" messageRef="Message_Linimasa_amandemen" />
    <bpmn:messageFlow id="m-w5-user" name="Teks berwarna" sourceRef="w5" targetRef="user" messageRef="Message_Teks_berwarna" />
    <bpmn:messageFlow id="m-user-tahun" name="Pilih tahun linimasa" sourceRef="user" targetRef="tahun" messageRef="Message_Pilih_tahun_linimasa" />
    <bpmn:messageFlow id="m-user-teks" name="Klik teks berwarna" sourceRef="user" targetRef="teks" messageRef="Message_Klik_teks_berwarna" />
    <bpmn:messageFlow id="m-user-graf" name="Buka graf relasi" sourceRef="user" targetRef="graf" messageRef="Message_Buka_graf_relasi" />
    <bpmn:messageFlow id="m-user-tutup" name="Tutup mode lacak" sourceRef="user" targetRef="tutup" messageRef="Message_Tutup_mode_lacak" />
    <bpmn:messageFlow id="m-versi-user" name="Teks versi terpilih" sourceRef="versi" targetRef="user" messageRef="Message_Teks_versi_terpilih" />
    <bpmn:messageFlow id="m-b3-user" name="Tampilan berdampingan" sourceRef="b3" targetRef="user" messageRef="Message_Tampilan_berdampingan" />
    <bpmn:messageFlow id="m-g3-user" name="Graf relasi UU" sourceRef="g3" targetRef="user" messageRef="Message_Graf_relasi_UU" />
  </bpmn:collaboration>
  <bpmn:process id="lacak_amandemen" name="Lacak Amandemen (Pelacak Dokumen Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_lacak_amandemen" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:parallelGateway id="pisah" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="versi" name="Tampilkan Teks Versi Terpilih" messageRef="Message_Teks_versi_terpilih">
      <bpmn:ioSpecification id="versi-io">
        <bpmn:dataInput id="versi-in-4" name="Undang-Undang" />
        <bpmn:inputSet id="versi-inputs">
          <bpmn:dataInputRefs>versi-in-4</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="versi-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="versi-dia-4">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>versi-in-4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:endEvent id="selesai" name="Selesai melacak amandemen" />
    <bpmn:subProcess id="linimasa" name="Tampilkan Linimasa Amandemen">
      <bpmn:startEvent id="l1" name="Mulai linimasa" />
      <bpmn:serviceTask id="l2" name="Kelompokkan Amandemen per Tahun">
        <bpmn:ioSpecification id="l2-io">
          <bpmn:dataInput id="l2-in-1" name="Riwayat Perubahan UU" />
          <bpmn:inputSet id="l2-inputs">
            <bpmn:dataInputRefs>l2-in-1</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="l2-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="l2-dia-1">
          <bpmn:sourceRef>d_riw</bpmn:sourceRef>
          <bpmn:targetRef>l2-in-1</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:sendTask id="l3" name="Tampilkan linimasa per tahun" messageRef="Message_Linimasa_amandemen" />
      <bpmn:endEvent id="l4" name="Linimasa tampil" />
      <bpmn:sequenceFlow id="f-l1-l2" sourceRef="l1" targetRef="l2" />
      <bpmn:sequenceFlow id="f-l2-l3" sourceRef="l2" targetRef="l3" />
      <bpmn:sequenceFlow id="f-l3-l4" sourceRef="l3" targetRef="l4" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="gabung" />
    <bpmn:exclusiveGateway id="loop" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="tahun" name="Pengguna memilih tahun linimasa">
      <bpmn:messageEventDefinition id="tahun-def" messageRef="Message_Pilih_tahun_linimasa" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="teks" name="Pengguna mengklik teks berwarna">
      <bpmn:messageEventDefinition id="teks-def" messageRef="Message_Klik_teks_berwarna" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="graf" name="Pengguna membuka graf relasi">
      <bpmn:messageEventDefinition id="graf-def" messageRef="Message_Buka_graf_relasi" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna menutup mode lacak">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Tutup_mode_lacak" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="sidebar" name="Tampilkan Sidebar Detail Perubahan">
      <bpmn:startEvent id="s1" name="Teks berwarna diklik" />
      <bpmn:serviceTask id="s2" name="Ambil Riwayat Perubahan">
        <bpmn:ioSpecification id="s2-io">
          <bpmn:dataInput id="s2-in-5" name="Riwayat Perubahan UU" />
          <bpmn:inputSet id="s2-inputs">
            <bpmn:dataInputRefs>s2-in-5</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="s2-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="s2-dia-5">
          <bpmn:sourceRef>d_riw</bpmn:sourceRef>
          <bpmn:targetRef>s2-in-5</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:callActivity id="s3" name="Tampilkan Sumber UU Pengubah" calledElement="lihat_detail_undang_undang">
        <bpmn:documentation>Memanggil proses Lihat Detail Undang-Undang untuk UU pengubah</bpmn:documentation>
      </bpmn:callActivity>
      <bpmn:subProcess id="s4" name="Bandingkan Versi Pasal">
        <bpmn:startEvent id="b1" name="Mulai perbandingan" />
        <bpmn:serviceTask id="b2" name="Hitung Selisih Teks">
          <bpmn:ioSpecification id="b2-io">
            <bpmn:dataInput id="b2-in-6" name="Undang-Undang" />
            <bpmn:inputSet id="b2-inputs">
              <bpmn:dataInputRefs>b2-in-6</bpmn:dataInputRefs>
            </bpmn:inputSet>
            <bpmn:outputSet id="b2-outputs" />
          </bpmn:ioSpecification>
          <bpmn:dataInputAssociation id="b2-dia-6">
            <bpmn:sourceRef>d_uu</bpmn:sourceRef>
            <bpmn:targetRef>b2-in-6</bpmn:targetRef>
          </bpmn:dataInputAssociation>
        </bpmn:serviceTask>
        <bpmn:sendTask id="b3" name="Tampilkan Tampilan Berdampingan" messageRef="Message_Tampilan_berdampingan" />
        <bpmn:endEvent id="b4" name="Perbandingan tampil" />
        <bpmn:sequenceFlow id="f-b1-b2" sourceRef="b1" targetRef="b2" />
        <bpmn:sequenceFlow id="f-b2-b3" sourceRef="b2" targetRef="b3" />
        <bpmn:sequenceFlow id="f-b3-b4" sourceRef="b3" targetRef="b4" />
      </bpmn:subProcess>
      <bpmn:endEvent id="s5" name="Sidebar tampil" />
      <bpmn:sequenceFlow id="f-s1-s2" sourceRef="s1" targetRef="s2" />
      <bpmn:sequenceFlow id="f-s2-s3" sourceRef="s2" targetRef="s3" />
      <bpmn:sequenceFlow id="f-s3-s4" sourceRef="s3" targetRef="s4" />
      <bpmn:sequenceFlow id="f-s4-s5" sourceRef="s4" targetRef="s5" />
    </bpmn:subProcess>
    <bpmn:subProcess id="warna" name="Terapkan Penandaan Warna Perubahan">
      <bpmn:startEvent id="w1" name="Mulai penandaan" />
      <bpmn:serviceTask id="w2" name="Tandai Teks Dihapus">
        <bpmn:ioSpecification id="w2-io">
          <bpmn:dataInput id="w2-in-2" name="Riwayat Perubahan UU" />
          <bpmn:inputSet id="w2-inputs">
            <bpmn:dataInputRefs>w2-in-2</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="w2-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="w2-dia-2">
          <bpmn:sourceRef>d_riw</bpmn:sourceRef>
          <bpmn:targetRef>w2-in-2</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="w3" name="Tandai Teks Disisipkan atau Direvisi">
        <bpmn:ioSpecification id="w3-io">
          <bpmn:dataInput id="w3-in-3" name="Riwayat Perubahan UU" />
          <bpmn:inputSet id="w3-inputs">
            <bpmn:dataInputRefs>w3-in-3</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="w3-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="w3-dia-3">
          <bpmn:sourceRef>d_riw</bpmn:sourceRef>
          <bpmn:targetRef>w3-in-3</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:sendTask id="w5" name="Tampilkan teks berwarna" messageRef="Message_Teks_berwarna" />
      <bpmn:endEvent id="w4" name="Teks berwarna" />
      <bpmn:sequenceFlow id="f-w1-w2" sourceRef="w1" targetRef="w2" />
      <bpmn:sequenceFlow id="f-w2-w3" sourceRef="w2" targetRef="w3" />
      <bpmn:sequenceFlow id="f-w3-w5" sourceRef="w3" targetRef="w5" />
      <bpmn:sequenceFlow id="f-w5-w4" sourceRef="w5" targetRef="w4" />
    </bpmn:subProcess>
    <bpmn:subProcess id="grafrel" name="Visualisasikan Relasi Undang-Undang">
      <bpmn:startEvent id="g1" name="Mulai visualisasi" />
      <bpmn:serviceTask id="g2" name="Bangun Graf Relasi">
        <bpmn:ioSpecification id="g2-io">
          <bpmn:dataInput id="g2-in-7" name="Riwayat Perubahan UU" />
          <bpmn:inputSet id="g2-inputs">
            <bpmn:dataInputRefs>g2-in-7</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="g2-outputs" />
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="g2-dia-7">
          <bpmn:sourceRef>d_riw</bpmn:sourceRef>
          <bpmn:targetRef>g2-in-7</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:sendTask id="g3" name="Tampilkan Graf Relasi" messageRef="Message_Graf_relasi_UU" />
      <bpmn:endEvent id="g4" name="Graf tampil" />
      <bpmn:sequenceFlow id="f-g1-g2" sourceRef="g1" targetRef="g2" />
      <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
      <bpmn:sequenceFlow id="f-g3-g4" sourceRef="g3" targetRef="g4" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pisah" name="ya" sourceRef="izin" targetRef="pisah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pisah-linimasa" sourceRef="pisah" targetRef="linimasa" />
    <bpmn:sequenceFlow id="f-pisah-warna" sourceRef="pisah" targetRef="warna" />
    <bpmn:sequenceFlow id="f-tahun-versi" sourceRef="tahun" targetRef="versi" />
    <bpmn:sequenceFlow id="f-versi-loop" sourceRef="versi" targetRef="loop" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-linimasa-gabung" sourceRef="linimasa" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-warna-gabung" sourceRef="warna" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-loop" sourceRef="gabung" targetRef="loop" />
    <bpmn:sequenceFlow id="f-loop-tunggu" sourceRef="loop" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-grafrel-loop" sourceRef="grafrel" targetRef="loop" />
    <bpmn:sequenceFlow id="f-sidebar-loop" sourceRef="sidebar" targetRef="loop" />
    <bpmn:sequenceFlow id="f-tunggu-tahun" sourceRef="tunggu" targetRef="tahun" />
    <bpmn:sequenceFlow id="f-tunggu-teks" sourceRef="tunggu" targetRef="teks" />
    <bpmn:sequenceFlow id="f-tunggu-graf" sourceRef="tunggu" targetRef="graf" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-teks-sidebar" sourceRef="teks" targetRef="sidebar" />
    <bpmn:sequenceFlow id="f-graf-grafrel" sourceRef="graf" targetRef="grafrel" />
    <bpmn:dataStoreReference id="d_riw" name="Riwayat Perubahan UU" dataStoreRef="d_riw-store" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
