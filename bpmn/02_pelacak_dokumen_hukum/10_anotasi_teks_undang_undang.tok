tok 0.5 "Anotasi Teks Undang-Undang (Pelacak Dokumen Hukum)"

pool p "Anotasi Teks Undang-Undang" process=anotasi_teks_undang_undang
  start mulai "Permintaan diterima" message="Pasal dan aksi anotasi"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  xor aksi "Aksi anotasi?"
  end tolak "Akses ditolak" message="Akses ditolak"
  send tampil "Tampilkan Anotasi Pasal" message="Anotasi pasal"
  receive tulis "Terima isi catatan baru" message="Isi catatan baru"
  service buat "Buat Anotasi"
  receive ubahisi "Terima isi catatan yang diubah" message="Isi catatan diubah"
  service ubah "Ubah Anotasi"
  service tanda "Beri Penanda Pasal"
  xor gabung
  send minta "Minta konfirmasi penghapusan catatan" message="Permintaan konfirmasi hapus"
  eventgw tunggu
  service hapus "Hapus Anotasi"
  end selesai "Anotasi diproses" message="Konfirmasi anotasi"
  end batal "Penghapusan dibatalkan"
  catch tidak "Pengguna membatalkan hapus" message="Batal hapus"
  catch ya "Pengguna mengonfirmasi hapus" message="Konfirmasi hapus"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> aksi "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow aksi -> tulis "buat catatan" when="aksi = \"buat\""
flow aksi -> ubahisi "ubah catatan" when="aksi = \"ubah\""
flow aksi -> minta "hapus catatan" when="aksi = \"hapus\""
flow aksi -> tanda "beri penanda" when="aksi = \"tanda\""
flow aksi -> tampil "lihat catatan" when="aksi = \"lihat\""
flow ubah -> gabung
flow tampil -> gabung
flow tanda -> gabung
flow buat -> gabung id=Flow_0ypasfw
flow gabung -> selesai
flow tulis -> buat
flow ubahisi -> ubah
flow hapus -> gabung
flow minta -> tunggu
flow tunggu -> ya
flow tunggu -> tidak
flow ya -> hapus
flow tidak -> batal

message user -> mulai "Pasal dan aksi anotasi"
message tolak -> user "Akses ditolak"
message user -> tulis "Isi catatan baru"
message user -> ubahisi "Isi catatan diubah"
message minta -> user "Permintaan konfirmasi hapus"
message user -> ya "Konfirmasi hapus"
message user -> tidak "Batal hapus"
message tampil -> user "Anotasi pasal"
message selesai -> user "Konfirmasi anotasi"
