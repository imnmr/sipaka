<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Keluar (Kelola Akun &amp; Akses)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Permintaan_keluar" name="Permintaan keluar" />
  <bpmn:message id="Message_Halaman_masuk" name="Halaman masuk" />
  <bpmn:dataStore id="d_sesi-store" name="Sesi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Keluar" processRef="keluar" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan keluar" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_keluar" />
    <bpmn:messageFlow id="m-arah-user" name="Halaman masuk" sourceRef="arah" targetRef="user" messageRef="Message_Halaman_masuk" />
  </bpmn:collaboration>
  <bpmn:process id="keluar" name="Keluar (Kelola Akun &amp; Akses)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan keluar diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_keluar" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="aktif" name="Sesi masih aktif?" default="f-aktif-hapus" />
    <bpmn:serviceTask id="akhiri" name="Akhiri Sesi">
      <bpmn:dataOutputAssociation id="akhiri-doa-1">
        <bpmn:targetRef>d_sesi</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="hapus" name="Hapus token sesi di perangkat" />
    <bpmn:sendTask id="arah" name="Arahkan ke halaman masuk" messageRef="Message_Halaman_masuk" />
    <bpmn:endEvent id="selesai" name="Pengguna keluar dari SIPAKA" />
    <bpmn:sequenceFlow id="f-mulai-aktif" sourceRef="mulai" targetRef="aktif" />
    <bpmn:sequenceFlow id="f-aktif-akhiri" name="ya" sourceRef="aktif" targetRef="akhiri">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sesiAktif</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aktif-hapus" name="tidak" sourceRef="aktif" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-akhiri-hapus" sourceRef="akhiri" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-hapus-arah" sourceRef="hapus" targetRef="arah" />
    <bpmn:sequenceFlow id="f-arah-selesai" sourceRef="arah" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_sesi" name="Sesi" dataStoreRef="d_sesi-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="770" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="770" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="114" width="56" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aktif_di" bpmnElement="aktif" isMarkerVisible="true">
        <dc:Bounds x="306" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="283" y="200" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="akhiri_di" bpmnElement="akhiri">
        <dc:Bounds x="406" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hapus_di" bpmnElement="hapus">
        <dc:Bounds x="556" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arah_di" bpmnElement="arah">
        <dc:Bounds x="706" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="856" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="832" y="193" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_sesi_di" bpmnElement="d_sesi">
        <dc:Bounds x="431" y="260" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="444" y="315" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="238" y="380" />
        <di:waypoint x="238" y="188" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="243" y="272" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-arah-user_di" bpmnElement="m-arah-user">
        <di:waypoint x="756" y="210" />
        <di:waypoint x="756" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="761" y="283" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="akhiri-doa-1_di" bpmnElement="akhiri-doa-1">
        <di:waypoint x="456" y="210" />
        <di:waypoint x="456" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-mulai-aktif_di" bpmnElement="f-mulai-aktif">
        <di:waypoint x="256" y="170" />
        <di:waypoint x="306" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-aktif-akhiri_di" bpmnElement="f-aktif-akhiri">
        <di:waypoint x="356" y="170" />
        <di:waypoint x="406" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="364" y="155" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-aktif-hapus_di" bpmnElement="f-aktif-hapus">
        <di:waypoint x="331" y="145" />
        <di:waypoint x="331" y="100" />
        <di:waypoint x="606" y="100" />
        <di:waypoint x="606" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="338" y="105" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-akhiri-hapus_di" bpmnElement="f-akhiri-hapus">
        <di:waypoint x="506" y="178" />
        <di:waypoint x="556" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-hapus-arah_di" bpmnElement="f-hapus-arah">
        <di:waypoint x="656" y="170" />
        <di:waypoint x="706" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-arah-selesai_di" bpmnElement="f-arah-selesai">
        <di:waypoint x="806" y="170" />
        <di:waypoint x="856" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
