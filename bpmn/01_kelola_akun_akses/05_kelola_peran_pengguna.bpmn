        <di:waypoint x="656" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="607" y="129" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-aksi-cabut_di" bpmnElement="f-aksi-cabut">
        <di:waypoint x="606" y="150" />
        <di:waypoint x="631" y="150" />
        <di:waypoint x="631" y="370" />
        <di:waypoint x="656" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="595" y="256" width="28" height="14" />
