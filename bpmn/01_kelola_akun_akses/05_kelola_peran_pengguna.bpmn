<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Kelola Peran Pengguna (Kelola Akun &amp; Akses)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Permintaan_ubah_peran" name="Permintaan ubah peran" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konfirmasi_perubahan_peran" name="Konfirmasi perubahan peran" />
  <bpmn:dataStore id="d_sesi-store" name="Sesi" />
  <bpmn:dataStore id="d_peran-store" name="Peran Pengguna" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Kelola Peran Pengguna" processRef="kelola_peran_pengguna" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="Permintaan ubah peran" sourceRef="admin" targetRef="mulai" messageRef="Message_Permintaan_ubah_peran" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi perubahan peran" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_perubahan_peran" />
  </bpmn:collaboration>
  <bpmn:process id="kelola_peran_pengguna" name="Kelola Peran Pengguna (Kelola Akun &amp; Akses)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan ubah peran diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_ubah_peran" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:exclusiveGateway id="aksi" name="Aksi yang diminta?" default="f-aksi-cabut" />
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:serviceTask id="sinkron" name="Perbarui hak akses pada sesi aktif pengguna">
      <bpmn:dataOutputAssociation id="sinkron-doa-3">
        <bpmn:targetRef>d_sesi</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Peran pengguna diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_perubahan_peran" />
    </bpmn:endEvent>
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="cabut" name="Cabut Peran Pengguna">
      <bpmn:dataOutputAssociation id="cabut-doa-2">
        <bpmn:targetRef>d_peran</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="tetapkan" name="Tetapkan Peran Pengguna">
      <bpmn:dataOutputAssociation id="tetapkan-doa-1">
        <bpmn:targetRef>d_peran</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-aksi" name="ya" sourceRef="izin" targetRef="aksi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-aksi-tetapkan" name="tetapkan" sourceRef="aksi" targetRef="tetapkan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "tetapkan"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-cabut" name="cabut" sourceRef="aksi" targetRef="cabut" />
    <bpmn:sequenceFlow id="f-tetapkan-gabung" sourceRef="tetapkan" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-cabut-gabung" sourceRef="cabut" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-sinkron" sourceRef="gabung" targetRef="sinkron" />
    <bpmn:sequenceFlow id="f-sinkron-selesai" sourceRef="sinkron" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_sesi" name="Sesi" dataStoreRef="d_sesi-store" />
    <bpmn:dataStoreReference id="d_peran" name="Peran Pengguna" dataStoreRef="d_peran-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="970" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="admin_di" bpmnElement="admin" isHorizontal="true">
        <dc:Bounds x="160" y="490" width="970" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="244" y="171" width="56" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auth_di" bpmnElement="auth">
        <dc:Bounds x="306" y="110" width="100" height="80" />
