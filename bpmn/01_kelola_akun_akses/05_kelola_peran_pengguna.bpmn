          <dc:Bounds x="530" y="180" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gabung_di" bpmnElement="gabung" isMarkerVisible="true">
        <dc:Bounds x="806" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sinkron_di" bpmnElement="sinkron">
        <dc:Bounds x="906" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="1056" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1013" y="171" width="56" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tolak_di" bpmnElement="tolak">
        <dc:Bounds x="463" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="283" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cabut_di" bpmnElement="cabut">
        <dc:Bounds x="656" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tetapkan_di" bpmnElement="tetapkan">
        <dc:Bounds x="656" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_sesi_di" bpmnElement="d_sesi">
        <dc:Bounds x="931" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="944" y="310" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_peran_di" bpmnElement="d_peran">
        <dc:Bounds x="681" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="736" y="255" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-admin-mulai_di" bpmnElement="m-admin-mulai">
        <di:waypoint x="238" y="490" />
        <di:waypoint x="238" y="168" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="243" y="457" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tolak-admin_di" bpmnElement="m-tolak-admin">
        <di:waypoint x="481" y="308" />
        <di:waypoint x="481" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="387" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-selesai-admin_di" bpmnElement="m-selesai-admin">
        <di:waypoint x="1074" y="168" />
        <di:waypoint x="1074" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="458" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sinkron-doa-3_di" bpmnElement="sinkron-doa-3">
        <di:waypoint x="956" y="190" />
        <di:waypoint x="956" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cabut-doa-2_di" bpmnElement="cabut-doa-2">
        <di:waypoint x="706" y="330" />
        <di:waypoint x="706" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tetapkan-doa-1_di" bpmnElement="tetapkan-doa-1">
        <di:waypoint x="706" y="190" />
        <di:waypoint x="706" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-mulai-auth_di" bpmnElement="f-mulai-auth">
