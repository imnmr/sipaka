      <bpmndi:BPMNShape id="d_akun_di" bpmnElement="d_akun">
        <dc:Bounds x="331" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="319" y="330" width="74" height="27" />
