        <di:waypoint x="238" y="188" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="236" y="489" width="98" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-sukses-user_di" bpmnElement="m-sukses-user">
        <di:waypoint x="747" y="178" />
        <di:waypoint x="763" y="178" />
        <di:waypoint x="763" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="765" y="369" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
