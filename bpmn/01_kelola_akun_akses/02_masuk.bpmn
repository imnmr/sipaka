      <bpmndi:BPMNShape id="benar_di" bpmnElement="benar" isMarkerVisible="true">
        <dc:Bounds x="456" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="487" y="198" width="56" height="27" />
