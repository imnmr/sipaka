<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Otorisasi Akses (Kelola Akun &amp; Akses)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.5">
  <bpmn:dataStore id="d_sesi-store" name="Sesi" />
  <bpmn:dataStore id="d_peran-store" name="Peran Pengguna" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Otorisasi Akses" processRef="otorisasi_akses" />
  </bpmn:collaboration>
  <bpmn:process id="otorisasi_akses" name="Otorisasi Akses (Kelola Akun &amp; Akses)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan akses diterima" />
    <bpmn:serviceTask id="token" name="Validasi Token Sesi">
      <bpmn:ioSpecification id="token-io">
        <bpmn:dataInput id="token-in-1" name="Sesi" />
        <bpmn:inputSet id="token-inputs">
          <bpmn:dataInputRefs>token-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="token-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="token-dia-1">
        <bpmn:sourceRef>d_sesi</bpmn:sourceRef>
        <bpmn:targetRef>token-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="tokenok" name="Token valid dan belum kedaluwarsa?" default="f-tokenok-tolaksesi" />
    <bpmn:serviceTask id="izin" name="Periksa Izin Peran">
      <bpmn:ioSpecification id="izin-io">
        <bpmn:dataInput id="izin-in-2" name="Peran Pengguna" />
        <bpmn:inputSet id="izin-inputs">
          <bpmn:dataInputRefs>izin-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="izin-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="izin-dia-2">
        <bpmn:sourceRef>d_peran</bpmn:sourceRef>
        <bpmn:targetRef>izin-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="izinok" name="Peran berhak mengakses fungsi?" default="f-izinok-tolakperan" />
    <bpmn:endEvent id="diizinkan" name="Akses diizinkan" />
    <bpmn:endEvent id="tolakperan" name="Akses ditolak: izin tidak cukup" />
    <bpmn:endEvent id="tolaksesi" name="Akses ditolak: sesi tidak valid" />
    <bpmn:sequenceFlow id="f-mulai-token" sourceRef="mulai" targetRef="token" />
    <bpmn:sequenceFlow id="f-token-tokenok" sourceRef="token" targetRef="tokenok" />
    <bpmn:sequenceFlow id="f-tokenok-izin" name="ya" sourceRef="tokenok" targetRef="izin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tokenValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-tokenok-tolaksesi" name="tidak" sourceRef="tokenok" targetRef="tolaksesi" />
    <bpmn:sequenceFlow id="f-izin-izinok" sourceRef="izin" targetRef="izinok" />
    <bpmn:sequenceFlow id="f-izinok-diizinkan" name="ya" sourceRef="izinok" targetRef="diizinkan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">peranBerhak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izinok-tolakperan" name="tidak" sourceRef="izinok" targetRef="tolakperan" />
    <bpmn:dataStoreReference id="d_sesi" name="Sesi" dataStoreRef="d_sesi-store" />
    <bpmn:dataStoreReference id="d_peran" name="Peran Pengguna" dataStoreRef="d_peran-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="720" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="220" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="193" y="183" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="token_di" bpmnElement="token">
        <dc:Bounds x="306" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tokenok_di" bpmnElement="tokenok" isMarkerVisible="true">
        <dc:Bounds x="456" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="424" y="104" width="113" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="izin_di" bpmnElement="izin">
        <dc:Bounds x="556" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="izinok_di" bpmnElement="izinok" isMarkerVisible="true">
        <dc:Bounds x="706" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="104" width="96" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="diizinkan_di" bpmnElement="diizinkan">
        <dc:Bounds x="806" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="183" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tolakperan_di" bpmnElement="tolakperan">
        <dc:Bounds x="713" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="677" y="298" width="108" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tolaksesi_di" bpmnElement="tolaksesi">
        <dc:Bounds x="463" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="427" y="301" width="108" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_sesi_di" bpmnElement="d_sesi">
        <dc:Bounds x="331" y="250" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="344" y="305" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_peran_di" bpmnElement="d_peran">
        <dc:Bounds x="581" y="250" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="566" y="305" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="token-dia-1_di" bpmnElement="token-dia-1">
        <di:waypoint x="356" y="250" />
        <di:waypoint x="356" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="izin-dia-2_di" bpmnElement="izin-dia-2">
        <di:waypoint x="606" y="250" />
        <di:waypoint x="606" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-mulai-token_di" bpmnElement="f-mulai-token">
        <di:waypoint x="256" y="160" />
        <di:waypoint x="306" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-token-tokenok_di" bpmnElement="f-token-tokenok">
        <di:waypoint x="406" y="160" />
        <di:waypoint x="456" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-tokenok-izin_di" bpmnElement="f-tokenok-izin">
        <di:waypoint x="506" y="160" />
        <di:waypoint x="556" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="145" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-tokenok-tolaksesi_di" bpmnElement="f-tokenok-tolaksesi">
        <di:waypoint x="481" y="185" />
        <di:waypoint x="481" y="257" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="446" y="193" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-izin-izinok_di" bpmnElement="f-izin-izinok">
        <di:waypoint x="656" y="160" />
        <di:waypoint x="706" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-izinok-diizinkan_di" bpmnElement="f-izinok-diizinkan">
        <di:waypoint x="756" y="160" />
        <di:waypoint x="806" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="764" y="144" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-izinok-tolakperan_di" bpmnElement="f-izinok-tolakperan">
        <di:waypoint x="731" y="185" />
        <di:waypoint x="731" y="257" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="725" y="199" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
